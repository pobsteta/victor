# ============================================================
#  VICTOR Local — configuration
#  1) Copie ce fichier et renomme la copie en ".env"
#  2) Colle tes deux clés ci-dessous (voir README, étapes 2 et 3)
# ============================================================

# REQUIS — clé API Gradium (oreille + voix) : https://gradium.ai
GRADIUM_API_KEY=

# REQUIS — clé API Anthropic (le "cerveau" de VICTOR) : https://console.anthropic.com
# (différente de ton abonnement Claude Pro, qui sert aux tâches Claude Code)
ANTHROPIC_API_KEY=

# ------------------------------------------------------------
# Optionnel : décommente (enlève le #) pour changer les défauts
# ------------------------------------------------------------

# Comment VICTOR t'appelle
# VICTOR_TITRE=monsieur

# Voix Gradium (défaut : Gaspard, voix française masculine posée).
# Autres voix françaises : Marius biuhvu17TxVKOcyy · Jules YKeBw3OV1RgpdhLh
#   Damien 25AzBFyp6svYnJsj · Augustin Tek4tJXiX6_yvXq7 · Apolline 6oIkS98REoVZ1dEw
#   Noémie FXxJ9mANRq6BCTX5 · Solène YhIHaAfQ0cQPDV9R
# VICTOR_VOICE_ID=iEu63s1rhn_kegTr

# Langue (fr, en, es, de, pt)
# VICTOR_LANGUAGE=fr

# Modèle Claude du cerveau (Haiku = le plus rapide)
# VICTOR_MODEL=claude-haiku-4-5-20251001

# Serveur Gradium : eu.api.gradium.ai (Europe), us.api.gradium.ai ou api.gradium.ai
# GRADIUM_HOST=eu.api.gradium.ai

# --- Réactivité de la conversation
# Délai de transcription en trames de 80 ms (7 = plus rapide, 55 = plus précis)
# VICTOR_STT_DELAY=10
# Fin de phrase : horizon du VAD sémantique (0.5, 1, 2 ou 3 s) et seuil de silence.
# Plus petit = VICTOR répond plus vite, mais risque de te couper si tu marques une pause.
# VICTOR_TURN_HORIZON=1.0
# VICTOR_TURN_THRESHOLD=0.5
# Interrompre VICTOR en parlant (1) ; mets 0 si VICTOR s'interrompt tout seul
# (haut-parleurs sans casque qui renvoient sa voix dans le micro)
# VICTOR_BARGE_IN=1

# --- Économie de crédits Gradium
# La transcription ne tourne que quand le micro capte un son au-dessus de ce seuil,
# et se met en veille après VICTOR_STT_IDLE_CLOSE secondes de silence.
# 0 = transcription permanente (consomme en continu).
# VICTOR_MIC_THRESHOLD=0.02
# VICTOR_STT_IDLE_CLOSE=8

# --- Tâches Claude Code
# Dossier où travaillent les sessions Claude Code
# (par défaut : ton dossier utilisateur — conseil : mets un dossier dédié)
# VICTOR_WORKDIR=C:/Users/TonNom/victor-workspace

# Plusieurs espaces de travail (ex. les dossiers AIGORA) : VICTOR choisit le bon
# selon la demande ("côté dev", "dans l'aigora business") ou le sujet.
# Format nom:chemin;nom:chemin — VICTOR_WORKDIR reste l'espace par défaut.
# VICTOR_ESPACES=business:~/dev/aigora/aigora-business;dev:~/dev/aigora/aigora-dev
# Une phrase par espace pour l'aider à choisir (même format) :
# VICTOR_ESPACES_DESC=business:mails kSuite, agenda, Odoo, prospection;dev:code R et Python, QGIS, revue de code

# Durée max d'une tâche Claude Code, en secondes
# VICTOR_TASK_TIMEOUT=600

# Mode de permission des sessions Claude Code (elles tournent sans interface :
# personne ne peut répondre à une demande d'autorisation)
#   bypassPermissions = tout est autorisé sans demande (défaut)
#   acceptEdits       = fichiers autorisés, commandes shell refusées
#   off               = comportement d'origine (une tâche qui demande restera bloquée)
# VICTOR_PERMISSION_MODE=bypassPermissions

# Port du serveur local
# VICTOR_PORT=8788
